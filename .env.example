# Fernruf — copy to .env and fill in. Never commit .env.

# Required: who the AI represents (fixed disclosure text). Replace the example name.
FERNRUF_PRINCIPAL_NAME="Alex Example"

# SIP / Asterisk (see docs/SETUP.md)
SIP_HOST=192.0.2.1
SIP_IP=192.0.2.1
SIP_PORT=5060
SIP_USER=
SIP_PASSWORD=
LAN_CIDR=192.0.2.0/24
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=fernruf
ASTERISK_ARI_PASSWORD=

# Safety (allowlist cannot be disabled)
FERNRUF_ALLOWLIST=
FERNRUF_QUIET_HOURS=20:00-08:00
# FERNRUF_QUIET_HOURS_ALLOW_OFF=true
# FERNRUF_QUIET_HOURS=off

# MCP service
FERNRUF_BIND_HOST=127.0.0.1
FERNRUF_BIND_PORT=8787
FERNRUF_MCP_TOKEN=

# LLM (OpenRouter-compatible)
FERNRUF_LLM_MODEL=openrouter/example-model
OPENROUTER_API_KEY=
FERNRUF_LLM_MOCK=false

# TTS
FISH_AUDIO_API_KEY=
FISH_VOICE_ID=
# Callee voice for `fernruf demo-call`. Falls back to FISH_VOICE_ID when empty.
# FERNRUF_DEMO_CALLEE_VOICE_ID=
# FERNRUF_DEMO_CALLEE_WS_PORT=8766

# Privacy / third parties (defaults: no TypeSafe/Jev; local STT only)
# FERNRUF_PRIVACY_MINIMAL=true
# FERNRUF_TYPESAFE_ENABLED=false
# TYPESAFE_API_KEY=
# FERNRUF_MOOD_ENABLED=false
# Optional fixed privacy notice after the AI disclosure (default: off)
# FERNRUF_SPOKEN_PRIVACY_ENABLED=true

# OAuth (optional remote MCP)
FERNRUF_OAUTH_ISSUER=https://fernruf.example.com
FERNRUF_OAUTH_RESOURCE=https://fernruf.example.com/mcp
FERNRUF_GITHUB_CALLBACK_URL=https://fernruf.example.com/oauth/github/callback
FERNRUF_GITHUB_ALLOWED_USER_IDS=
FERNRUF_GITHUB_CLIENT_ID=
FERNRUF_GITHUB_CLIENT_SECRET=

# Optional startup mail
FERNRUF_NOTIFY_ENABLED=false
