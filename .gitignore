.env
.env.*
!.env.example
# Runtime files. The directory placeholders stay tracked so a fresh clone
# already has the Asterisk bind-mount paths (Docker would otherwise create
# ./data as root).
data/*
!data/.gitkeep
!data/asterisk-sounds/
!data/asterisk-generated/
data/asterisk-sounds/*
!data/asterisk-sounds/.gitkeep
data/asterisk-generated/*
!data/asterisk-generated/.gitkeep
!data/asterisk-monitor/
data/asterisk-monitor/*
!data/asterisk-monitor/.gitkeep
var/
*.log
*.db
*.sqlite
*.sqlite3
*.jsonl
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
verify-evidence/
scripts/verify/fixtures/callee-hallo.alaw
scripts/verify/fixtures/callee-hallo-rtp.pcap
scripts/verify/fixtures/.sipp-loopback-*
*.wav
!tests/fixtures/*.wav
*.pcap
.DS_Store
.privacy-terms.local
